#: tarot/templates/tarot/base.html
#: tarot/templates/tarot/partials/journey_form.html
msgid "Celestial Insight"
msgstr "Celestial Insight"

#: tarot/templates/tarot/journey.html
msgid "Begin a reading · Celestial Insight"
msgstr "Почніть читання · Celestial Insight"

#: tarot/templates/tarot/reading_detail.html
msgid "Your reading · Celestial Insight"
msgstr "Ваше читання · Celestial Insight"

#: tarot/templates/tarot/partials/journey_form.html
msgid "Begin a reflective tarot reading"
msgstr "Почніть рефлексивне читання таро"

#: tarot/templates/tarot/partials/journey_form.html
msgid "Choose a guide and a spread. Your cards are saved before interpretation begins."
msgstr "Оберіть наставника й розклад. Ваші карти буде збережено до початку тлумачення."

#: tarot/templates/tarot/journey.html
msgid "Language"
msgstr "Мова"

#: tarot/templates/tarot/journey.html
msgid "Choose your guide"
msgstr "Оберіть наставника"

#: tarot/templates/tarot/partials/journey_form.html
msgid "Reading details"
msgstr "Деталі читання"

#: tarot/templates/tarot/reading_detail.html
msgid "New reading"
msgstr "Нове читання"

#: tarot/templates/tarot/partials/journey_form.html
msgid "Mentor"
msgstr "Наставник"

#: tarot/spreads.py
msgid "Single Card"
msgstr "Одна карта"

#: tarot/spreads.py
msgid "Past, Present, and Future"
msgstr "Минуле, теперішнє й майбутнє"

#: tarot/spreads.py
msgid "Celtic Cross"
msgstr "Кельтський хрест"

#: tarot/spreads.py
msgid "Career Growth"
msgstr "Кар’єрне зростання"

#: tarot/spreads.py
msgid "Love Choice"
msgstr "Вибір у стосунках"

#: tarot/templates/tarot/partials/journey_form.html
msgid "Your question"
msgstr "Ваше запитання"

#: tarot/templates/tarot/partials/journey_form.html
msgid "Spread"
msgstr "Розклад"

#: tarot/templates/tarot/partials/journey_form.html
msgid "Draw cards"
msgstr "Витягнути карти"

#: tarot/templates/tarot/partials/reading.html
msgid "Your reading"
msgstr "Ваше читання"

#: tarot/templates/tarot/partials/reading.html
msgid "Tarot offers space for reflection, not certain predictions or professional advice."
msgstr "Таро пропонує простір для роздумів, а не певні прогнози чи професійні поради."

#: tarot/templates/tarot/partials/reading.html
msgid "Interpretation could not be completed. Your original draw is still saved."
msgstr "Тлумачення не вдалося завершити. Ваш початковий розклад збережено."

#: tarot/templates/tarot/partials/reading.html
msgid "Retry interpretation"
msgstr "Повторити тлумачення"

#: tarot/templates/tarot/partials/reading.html
msgid "Your cards are saved. Interpretation is pending."
msgstr "Ваші карти збережено. Тлумачення очікує на виконання."

#: tarot/templates/tarot/partials/reading.html
msgid "Generate interpretation"
msgstr "Створити тлумачення"

#: tarot/templates/tarot/partials/reading.html
msgid "This reading belongs to this browser session. You can attach it after signing in later."
msgstr "Це читання належить цій сесії браузера. Пізніше ви зможете прив’язати його після входу."
