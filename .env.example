# LLM API Keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Django runtime. Set DJANGO_DEBUG=false and use a unique value in production.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_DB_PATH=db.sqlite3
CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Comma-separated browser origins permitted to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TAROT_JOURNEY_ENABLED=true

# Social
GITHUB_CLIENT_ID=xxxxxxxxx
GITHUB_CLIENT_SECRET=xxxxxx

GOOGLE_CLIENT_ID=xxxxx
GOOGLE_CLIENT_SECRET=xxxxx

# Telegram Web App authentication. Rotate this value in BotFather if it has ever
# appeared in source, logs, or chat history. TELEGRAM_BOT_ID is informational.
TELEGRAM_BOT_ID=123456789
TELEGRAM_BOT_TOKEN=replace-with-a-new-botfather-token
TELEGRAM_CHANNEL_ENABLED=false
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=300

# ADMIN
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=xxxxxxx
DJANGO_SUPERUSER_EMAIL=admin@example.com
