# =============================================================================
# Celestial Insight - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values
# For development, the defaults in settings.py work without a .env file

# -----------------------------------------------------------------------------
# Django Core Settings
# -----------------------------------------------------------------------------

# REQUIRED in production: Generate with `python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"`
# SECRET_KEY=your-secure-random-secret-key-here

# Set to False in production
# DEBUG=True

# Comma-separated list of allowed hosts (e.g., "example.com,www.example.com")
# ALLOWED_HOSTS=*

# Set to True for API-only mode, False to enable session-based login UI for HTMX
# HEADLESS_ONLY=False

# Set to False in production to prevent automatic login on GET requests (security best practice)
# SOCIALACCOUNT_LOGIN_ON_GET=False

# -----------------------------------------------------------------------------
# Database Configuration (optional - defaults to SQLite for development)
# -----------------------------------------------------------------------------
# Uncomment for PostgreSQL in production:
# DATABASE_URL=postgres://user:password@localhost:5432/celestial_insight

# -----------------------------------------------------------------------------
# LLM API Keys
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Social Authentication - GitHub
# -----------------------------------------------------------------------------
GITHUB_CLIENT_ID=xxxxxxxxx
GITHUB_CLIENT_SECRET=xxxxxx

# -----------------------------------------------------------------------------
# Social Authentication - Google
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=xxxxx
GOOGLE_CLIENT_SECRET=xxxxx

# -----------------------------------------------------------------------------
# Social Authentication - Telegram
# -----------------------------------------------------------------------------
# Get these from @BotFather on Telegram
TELEGRAM_BOT_ID=your-bot-id
TELEGRAM_BOT_SECRET=your-bot-token

# -----------------------------------------------------------------------------
# Django Admin (for createsuperuser --noinput)
# -----------------------------------------------------------------------------
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=xxxxxxx
DJANGO_SUPERUSER_EMAIL=admin@example.com
